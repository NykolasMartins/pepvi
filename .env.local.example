# =
# PEPVI — variáveis locais. No .gitignore: não vai pro Git.
# =

# --------------------------------------------------------------------------
# Supabase — URL do projeto. Público, vai para o navegador.
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# --------------------------------------------------------------------------
# CHAVE PÚBLICA (anon / publishable)  <-- PREENCHER
#
# Painel > Project Settings > API Keys > "anon public" (eyJ...) ou
# "publishable" (sb_publishable_...).
#
# Esta chave PODE ir para o navegador: ela respeita RLS. É com ela que a sessão
# do usuário passa a valer e as políticas do schema.sql entram em ação.
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --------------------------------------------------------------------------
# CHAVE SECRETA (service_role) — só servidor. IGNORA RLS.
#
# Agora usada em apenas dois lugares: emitir URL assinada de upload e o
# pipeline de correção (ler Storage privado, gravar corrections). Todo o resto
# passou a usar a sessão do usuário.
# --------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------------
# Google AI Studio — aistudio.google.com/apikey
# --------------------------------------------------------------------------
GEMINI_API_KEY=

# DEV_USER_ID foi removido: quem o usuário é agora vem da sessão.
